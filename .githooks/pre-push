#!/usr/bin/env bash
set -euo pipefail

# Lấy thư mục gốc của project
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$HOOK_DIR/.." && pwd)"
cd "$REPO_ROOT"

echo "🚀 Đang kiểm tra version từ file manifest.json..."

if [[ ! -f "manifest.json" ]]; then
  echo "❌ Không tìm thấy file manifest.json!" >&2
  exit 1
fi

# Đọc version từ manifest.json (bằng grep/sed để không cần dependency)
CURRENT_VERSION=$(grep -E '"version":\s*"[^"]+"' manifest.json | sed -E 's/.*"version":\s*"([^"]+)".*/\1/' | head -n 1)

if [[ -z "$CURRENT_VERSION" ]]; then
  echo "❌ Không thể đọc được version từ manifest.json!" >&2
  exit 1
fi

TAG_NAME="v$CURRENT_VERSION"

# Kiểm tra version hiện tại ở .cz.toml để xem có cần đồng bộ không
CZ_VERSION=$(grep -E '^version\s*=\s*".+"' .cz.toml 2>/dev/null | sed -E 's/.*version\s*=\s*"([^"]+)".*/\1/' | head -n 1 || echo "")

NEEDS_SYNC=0
if [[ "$CURRENT_VERSION" != "$CZ_VERSION" ]]; then
  NEEDS_SYNC=1
  echo "🔄 Đang tự động đồng bộ version $CURRENT_VERSION cho .cz.toml và package.json..."
  
  # Cập nhật .cz.toml (dùng sed)
  if [[ -f ".cz.toml" ]]; then
    sed -i -E "s/version = \"$CZ_VERSION\"/version = \"$CURRENT_VERSION\"/" .cz.toml
  fi
  
  # Cập nhật package.json (dùng Python cho an toàn)
  python -c "
import json
try:
    with open('web-src/package.json', 'r', encoding='utf-8') as f:
        data = json.load(f)
    data['version'] = '$CURRENT_VERSION'
    with open('web-src/package.json', 'w', encoding='utf-8') as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
except Exception:
    pass
"
  
  git add .cz.toml web-src/package.json
  git commit -m "chore(release): sync version to $CURRENT_VERSION"
fi

# Kiểm tra xem tag này đã tồn tại trong git chưa
if git rev-parse "$TAG_NAME" >/dev/null 2>&1; then
  if [[ $NEEDS_SYNC -eq 1 ]]; then
    echo "🔄 Đang đẩy code đã được đồng bộ version lên Github..."
    git push origin HEAD --no-verify
    
    echo "📦 Đang tự động build file .ankiaddon (lưu vào thư mục tmp/)..."
    if command -v python >/dev/null 2>&1; then
        python scripts/build_release.py
    fi
    
    echo "✅ Đã đồng bộ và push thành công."
    exit 1 # Hủy push gốc để tránh lỗi (vì đã push bằng lệnh trên)
  else
    echo "✅ Version $TAG_NAME đã tồn tại (không có thay đổi version mới)."
    echo "📦 Đang tự động build file .ankiaddon (lưu vào thư mục tmp/)..."
    if command -v python >/dev/null 2>&1; then
        python scripts/build_release.py
    fi
    
    echo "🔄 Đang tiếp tục lệnh push gốc của bạn..."
    exit 0
  fi
fi

# Nếu CHƯA CÓ TAG (tức là user vừa sửa version ở manifest.json)
echo "🌟 Phát hiện version mới: $TAG_NAME"
echo "🔖 Đang tạo Git tag $TAG_NAME..."
git tag "$TAG_NAME"

echo "🔄 Đang đẩy code và tag lên Github..."
git push origin HEAD --follow-tags --no-verify

echo "📦 Đang tự động build file .ankiaddon (lưu vào thư mục tmp/)..."
if command -v python >/dev/null 2>&1; then
    python scripts/build_release.py
fi

echo ""
echo "==============================================================="
echo "🎉🎉 HOÀN TẤT: CODE, TAGS VÀ RELEASE ($TAG_NAME) ĐÃ ĐƯỢC XỬ LÝ! 🎉🎉"
echo "==============================================================="
echo "⚠️ LƯU Ý: Vui lòng BỎ QUA dòng chữ 'error: failed to push some refs'"
echo "hiển thị ngay bên dưới. Đó chỉ là cảnh báo mặc định của Git do"
echo "script đã tự động làm thay công việc của nó!"
echo "==============================================================="

# Bắt buộc trả về 1 để hủy lệnh push CŨ của Git (tránh đè code hoặc lỗi non-fast-forward)
exit 1
